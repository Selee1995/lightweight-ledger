<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/padding_normal" android:layout_marginTop="@dimen/recycler_item_divider" android:layout_marginRight="@dimen/padding_normal" android:padding="@dimen/padding_normal" android:background="@drawable/bg_common_card_white" android:tag="layout/tally_module_home_item_month_info_0">
    <TextView
        android:id="@id/tvMonthExpenseLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/home_card_month_total_expense_label"
        android:textColor="@color/appTextColorThird"
        android:textSize="@dimen/app_text_size_small"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@id/tvMonthExpense"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:paddingTop="@dimen/spacing_normal"
        android:paddingBottom="@dimen/spacing_normal"
        android:textColor="@color/appTextColorPrimary"
        android:textSize="32.0sp"
        android:tag="binding_1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvMonthExpenseLabel" />

    <android.support.v7.widget.AppCompatImageView
        android:layout_width="60.0dp"
        android:layout_height="0.0dp"
        android:paddingLeft="20.0dp"
        android:paddingRight="20.0dp"
        android:background="@drawable/bg_clickable_view_40dp"
        android:tag="binding_5"
        app:layout_constraintBottom_toBottomOf="@id/tvMonthExpense"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvMonthExpense"
        app:srcCompat="@drawable/ic_eye_selector" />

    <TextView
        android:id="@id/tvMonthIncomeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_normal"
        android:text="@string/home_card_month_budget_label"
        android:textColor="@color/appTextColorThird"
        android:textSize="@dimen/app_text_size_small"
        app:layout_constraintEnd_toStartOf="@id/tvMonthIncome"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvMonthExpense" />

    <TextView
        android:id="@id/tvMonthIncome"
        android:layout_width="0.0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_normal"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="end"
        android:tag="binding_2"
        android:textColor="@color/appTextColorPrimary"
        android:textSize="@dimen/app_text_size_medium"
        app:layout_constraintBaseline_toBaselineOf="@id/tvMonthIncomeLabel"
        app:layout_constraintStart_toEndOf="@id/tvMonthIncomeLabel"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@id/tvMonthBudgetLeftLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_normal"
        android:text="@string/home_card_month_income_label"
        android:textColor="@color/appTextColorThird"
        android:textSize="@dimen/app_text_size_small"
        android:tag="binding_3"
        app:layout_constraintEnd_toStartOf="@id/tvMonthBudgetLeft"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvMonthIncome" />

    <TextView
        android:id="@id/tvMonthBudgetLeft"
        android:layout_width="0.0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_normal"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="end"
        android:tag="binding_4"
        android:textColor="@color/appTextColorPrimary"
        android:textSize="@dimen/app_text_size_medium"
        app:layout_constraintBaseline_toBaselineOf="@id/tvMonthBudgetLeftLabel"
        app:layout_constraintStart_toEndOf="@id/tvMonthBudgetLeftLabel"
        app:layout_constraintEnd_toEndOf="parent" />

    <android.support.v7.widget.AppCompatImageView
        android:id="@id/ivChart"
        android:layout_width="wrap_content"
        android:layout_height="45.0dp"
        android:layout_marginTop="@dimen/spacing_large"
        android:paddingTop="16.0dp"
        android:paddingBottom="16.0dp"
        android:tint="@color/colorAccent"
        app:layout_constraintEnd_toStartOf="@id/tvChartTip"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvMonthBudgetLeft"
        app:srcCompat="@drawable/ic_chart" />

    <TextView
        android:id="@id/tvChartTip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tally_module_home_check_chart"
        android:textColor="@color/colorAccent"
        android:textSize="@dimen/app_text_size_small"
        app:layout_constraintBottom_toBottomOf="@id/ivChart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/ivChart"
        app:layout_constraintTop_toTopOf="@id/ivChart" />
</android.support.constraint.ConstraintLayout>
